{
  "name": "wattle-technologies",
  "version": "0.1.0",
  "private": true,
  "description": "The corporate site for Wattle Technologies, the company behind ADHD.ME.",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm shaders && pnpm contrast && pnpm classes && pnpm build:verify",
    "contrast": "node scripts/contrast-gate.mjs",
    "classes": "node scripts/class-gate.mjs",
    "shaders": "node scripts/shader-gate.mjs",
    "build:verify": "NEXT_DIST_DIR=.next-verify next build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/bowlby-one": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.4",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
